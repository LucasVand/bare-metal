CompileFlags:
  CompilationDatabase: "builddir"

  Add: [
      "-ffreestanding",
      "-nostdinc",
      "-nostdlib",
      # Redirect standard system includes to a non-existent directory
      "--sysroot=/var/empty",
      "-isysroot=/var/empty",
      # "-resource-dir=/Users/lucasvanderwielen/.espressif/v6.1/tools/esp-clang/lib/clang/21",
      "-resource-dir=/Users/lucasvanderwielen/.espressif/v6.1/tools/tools/xtensa-esp-elf/esp-15.2.0_20251204/xtensa-esp-elf/bin/../lib/gcc/xtensa-esp-elf/15.2.0/include",
      "-isystem",
      # "/Users/lucasvanderwielen/.espressif/v6.1/tools/esp-clang/lib/clang/21/include",
      "/Users/lucasvanderwielen/.espressif/v6.1/tools/tools/xtensa-esp-elf/esp-15.2.0_20251204/xtensa-esp-elf/bin/../lib/gcc/xtensa-esp-elf/15.2.0/include"
    ]
  Remove: [
  "-fno-tree-loop-distribute-patterns"
  ]

